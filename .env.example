# =============================================================================
# Which brain drives the agent.
#   ollama    -> runs entirely on your machine. No API key, no cost, no network.
#   anthropic -> hosted Claude. Sharper, but needs a paid key.
# =============================================================================
PROVIDER=ollama

# --- Local (PROVIDER=ollama) -------------------------------------------------
# The model MUST support tool calling. Verified working, in order of preference:
#   qwen3:8b        ~5 GB  — best tool-calling quality per GB, recommended
#   llama3.1:8b     ~5 GB  — solid alternative
#   qwen3:4b        ~3 GB  — if you have under 8 GB of RAM
# Pull it first:  ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Context window. The agent resends a growing transcript each turn, so Ollama's
# small default will silently drop the system prompt mid-audit. Do not lower
# this unless you are short on RAM.
OLLAMA_NUM_CTX=16384

# --- Hosted (PROVIDER=anthropic) ---------------------------------------------
# Only needed if PROVIDER=anthropic. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5

# --- Agent guardrails --------------------------------------------------------
MAX_STEPS=14
MAX_TOOL_CALLS=30
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY_MB=1024

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_ROWS_SCANNED=500000

# --- Optional cost tracking (hosted only; local runs are free) ---------------
# Look these up at https://claude.com/pricing for your model.
# Left at 0, the app reports token counts only and never invents a dollar figure.
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0

LOG_LEVEL=INFO
LOG_JSON=false
API_URL=http://127.0.0.1:8000
