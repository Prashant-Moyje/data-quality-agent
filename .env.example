# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model. claude-sonnet-5 is the default workhorse.
# Use claude-haiku-4-5-20251001 while developing to keep costs near zero,
# or claude-opus-5 when you want the sharpest reasoning.
MODEL=claude-sonnet-5

# Agent guardrails
MAX_STEPS=14
MAX_TOOL_CALLS=30
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY_MB=1024

# Upload limits
MAX_UPLOAD_MB=50
MAX_ROWS_SCANNED=500000

# Optional cost tracking. Look these up at https://claude.com/pricing
# for the model you selected. Left at 0, the app reports tokens only.
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0

LOG_LEVEL=INFO
LOG_JSON=false
API_URL=http://127.0.0.1:8000
